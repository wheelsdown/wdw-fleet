{
  "openapi": "3.1.0",
  "info": {
    "title": "wdw-fleet",
    "description": "API-first vehicle fleet management service (FleetAware).",
    "version": "0.1.0-draft",
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "tags": [
    {
      "name": "System",
      "description": "Health, readiness, build metadata, and the OpenAPI contract itself."
    },
    {
      "name": "Users",
      "description": "User accounts, sessions, and per-user preferences."
    },
    {
      "name": "Site",
      "description": "Site-wide configuration: branding, units, integrations, admin."
    },
    {
      "name": "Fleet",
      "description": "Vehicles: the fleet."
    },
    {
      "name": "Fuel",
      "description": "Fuel fill-ups, economy calculation, and Road Trip HD import."
    },
    {
      "name": "Tasks",
      "description": "Work log: service, repair, inspection, modification, notes."
    },
    {
      "name": "Parts",
      "description": "Parts catalog and inventory."
    },
    {
      "name": "Expenses",
      "description": "Non-fuel monetary events (insurance, registration, tolls, ...)."
    },
    {
      "name": "Reminders",
      "description": "Date-, odometer-, and event-driven maintenance reminders."
    },
    {
      "name": "Track Events",
      "description": "Track events: HPDE, race, autocross sessions per vehicle."
    },
    {
      "name": "Inbox",
      "description": "IMAP-ingested receipts and other unfiled items awaiting routing."
    },
    {
      "name": "Webhooks",
      "description": "Outbound event delivery configuration."
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "getHealth",
        "summary": "Liveness probe. Always returns 200 if the process is up.",
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error (RFC 7807 problem+json).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-wdw-auth": "public"
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getOpenAPIJSON",
        "summary": "The OpenAPI 3.1 contract, JSON serialization.",
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "Error (RFC 7807 problem+json).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-wdw-auth": "public"
      }
    },
    "/openapi.yaml": {
      "get": {
        "operationId": "getOpenAPIYAML",
        "summary": "The OpenAPI 3.1 contract, YAML serialization.",
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "Error (RFC 7807 problem+json).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-wdw-auth": "public"
      }
    }
  },
  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Machine-readable error code."
          },
          "detail": {
            "type": "string",
            "description": "Human-readable explanation of this occurrence."
          },
          "instance": {
            "type": "string",
            "format": "uri",
            "description": "URI identifying this occurrence."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP status code."
          },
          "title": {
            "type": "string",
            "description": "Short human-readable summary."
          },
          "type": {
            "type": "string",
            "format": "uri",
            "description": "Problem type URI."
          }
        },
        "required": [
          "title",
          "status",
          "code"
        ]
      }
    }
  }
}
