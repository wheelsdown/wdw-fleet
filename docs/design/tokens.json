{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "FleetAware design tokens — both palettes, plus type, radius, spacing, shadow.",
  "color": {
    "light": {
      "teal":        { "$value": "#1f7a7f" },
      "tealDeep":    { "$value": "#155256" },
      "tealSoft":    { "$value": "#e6f2f2" },
      "orange":      { "$value": "#e85c2b" },
      "orangeSoft":  { "$value": "#fbe5db" },
      "ink":         { "$value": "#15181a" },
      "ink2":        { "$value": "#2a2e31" },
      "ink3":        { "$value": "#4a4f54" },
      "muted":       { "$value": "#7a7f85" },
      "faint":       { "$value": "#c5c9cd" },
      "line":        { "$value": "#e4e1d9" },
      "lineStrong":  { "$value": "#cfcac0" },
      "paper":       { "$value": "#f7f4ed" },
      "paperAlt":    { "$value": "#eeeae1" },
      "card":        { "$value": "#ffffff" },
      "good":        { "$value": "#2f7d4a" },
      "warn":        { "$value": "#b97a0e" },
      "bad":         { "$value": "#b03a2e" }
    },
    "dark": {
      "teal":        { "$value": "#4fb6bb" },
      "tealDeep":    { "$value": "#7ccacd" },
      "tealSoft":    { "$value": "#1c3a3c" },
      "orange":      { "$value": "#f07a4d" },
      "orangeSoft":  { "$value": "#3b241d" },
      "ink":         { "$value": "#ece8dc" },
      "ink2":        { "$value": "#d0ccc1" },
      "ink3":        { "$value": "#a6a297" },
      "muted":       { "$value": "#7d7a73" },
      "faint":       { "$value": "#3e4246" },
      "line":        { "$value": "#2b3033" },
      "lineStrong":  { "$value": "#3b4044" },
      "paper":       { "$value": "#14171a" },
      "paperAlt":    { "$value": "#1c1f23" },
      "card":        { "$value": "#22272a" },
      "good":        { "$value": "#67b886" },
      "warn":        { "$value": "#d4a64a" },
      "bad":         { "$value": "#d96b5c" }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": { "$value": "Inter, system-ui, -apple-system, 'Segoe UI', sans-serif" },
      "mono": { "$value": "'JetBrains Mono', SFMono-Regular, Menlo, monospace" }
    },
    "featureSettings": {
      "sans": { "$value": "'cv11', 'ss01', 'ss03'" },
      "mono": { "$value": "'zero', 'ss01'" }
    },
    "scale": {
      "h1":      { "$value": { "fontSize": 22, "fontWeight": 600, "letterSpacing": "-0.3px", "lineHeight": 1.2  } },
      "h2":      { "$value": { "fontSize": 16, "fontWeight": 600, "letterSpacing": "-0.1px", "lineHeight": 1.25 } },
      "eyebrow": { "$value": { "fontSize": 11, "fontWeight": 600, "letterSpacing": "0.6px",  "textTransform": "uppercase" } },
      "small":   { "$value": { "fontSize": 13, "fontWeight": 400, "lineHeight": 1.45 } },
      "tiny":    { "$value": { "fontSize": 11, "fontWeight": 400, "lineHeight": 1.4 } }
    }
  },
  "spacing": {
    "base":   { "$value": "4px", "$description": "Grid unit — all spacing derives from this." },
    "1":  { "$value": "4px" },
    "2":  { "$value": "8px" },
    "3":  { "$value": "12px" },
    "4":  { "$value": "16px" },
    "5":  { "$value": "20px" },
    "6":  { "$value": "24px" },
    "8":  { "$value": "32px" },
    "10": { "$value": "40px" }
  },
  "radius": {
    "chip":   { "$value": "3px" },
    "input":  { "$value": "4px" },
    "button": { "$value": "6px" },
    "card":   { "$value": "10px" },
    "modal":  { "$value": "10px" },
    "pill":   { "$value": "999px" },
    "avatar": { "$value": "15px" }
  },
  "shadow": {
    "modal":    { "$value": "0 24px 60px rgba(0,0,0,0.28)" },
    "toast":    { "$value": "0 8px 20px rgba(0,0,0,0.22)" },
    "dropdown": { "$value": "0 12px 28px rgba(0,0,0,0.18)" },
    "fab":      { "$value": "0 8px 20px rgba(232,92,43,0.35)" }
  },
  "focusRing": {
    "$value": {
      "border": "1px solid {color.light.teal}",
      "shadow": "0 0 0 3px {color.light.tealSoft}"
    }
  }
}
